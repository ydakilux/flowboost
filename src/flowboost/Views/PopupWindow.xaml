<Window x:Class="flowboost.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="flowboost" Width="640" Height="500" MinWidth="360" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/flowboost;component/Views/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.25" Color="#000000" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,13,12,12" Background="Transparent" PreviewMouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock x:Name="PresetTitle" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock x:Name="ModelLabel" Grid.Column="2" Foreground="{DynamicResource MutedForeground}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,7,0" />
                    <Border x:Name="HeaderStatusBadge" Grid.Column="3" Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,4" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed" IsHitTestVisible="False" ToolTip="Request status">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="BusyDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse x:Name="BusyDot1" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,3,0" />
                                <Ellipse x:Name="BusyDot2" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,3,0" />
                                <Ellipse x:Name="BusyDot3" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="HeaderStatusLabel" Foreground="{DynamicResource MutedForeground}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Grid.Column="1" Text="DRAG TO MOVE" Foreground="{DynamicResource MutedForeground}" FontSize="9" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                <Button x:Name="CopyButton" Grid.Column="2" Content="Copy" Style="{StaticResource QuietButton}" Padding="10,5" Margin="0,0,8,0" Click="Copy_Click" IsEnabled="False" />
                <Button Grid.Column="3" Content="×" FontSize="19" Width="32" Height="30" Background="Transparent" Foreground="{DynamicResource MutedForeground}" BorderThickness="0" Click="Close_Click" ToolTip="Close" />
            </Grid>
            <Border Grid.Row="1" Margin="12,0" Background="{DynamicResource PanelBackground}" CornerRadius="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15,12">
                    <StackPanel x:Name="ConversationPanel">
                        <TextBlock x:Name="SelectionPreview" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" FontSize="12" Margin="0,0,0,12" Visibility="Collapsed" />
                        <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="ComposerBorder" Grid.Row="2" Margin="12,10,12,12" Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8" PreviewMouseLeftButtonDown="Composer_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="FollowupBox" IsEnabled="False" Focusable="True" IsTabStop="True" IsReadOnly="False" BorderThickness="0" Background="Transparent" Padding="5,5" MinHeight="34" MaxHeight="90"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="Add a comment or question. Enter sends; Shift+Enter adds a line." KeyDown="FollowupBox_KeyDown" TextChanged="FollowupBox_TextChanged" />
                        <TextBlock x:Name="FollowupPlaceholder" Text="Add a comment or question…" Foreground="{DynamicResource MutedForeground}" Margin="5" VerticalAlignment="Top" IsHitTestVisible="False" />
                    </Grid>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send  ↗" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Send_Click" IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
