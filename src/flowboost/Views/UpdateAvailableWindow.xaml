<Window x:Class="flowboost.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A new version of flowboost is available" Width="560" Height="280"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" Icon="/flowboost;component/public/flowboost-transparent.png">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/flowboost;component/Views/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="A new version of flowboost is available" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedForeground}" Margin="0,12,0,0" />
            <TextBlock x:Name="ReleaseNameText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ExplanationText" Text="Downloads and installation happen on GitHub; flowboost never updates itself automatically."
                       Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,13,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,18,0,0">
            <Button Content="Skip this version" Style="{StaticResource QuietButton}" Click="Skip_Click" />
            <Button Content="Remind me later" Style="{StaticResource QuietButton}" Margin="8,0,0,0" IsCancel="True" Click="Later_Click" />
            <Button x:Name="OpenGitHubButton" Content="Open GitHub" Style="{StaticResource QuietButton}" Margin="8,0,0,0" IsDefault="True" Click="OpenGitHub_Click" />
            <Button x:Name="UpdateNowButton" Content="Update now" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="UpdateNow_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
