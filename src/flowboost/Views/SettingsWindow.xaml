<Window x:Class="flowboost.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MX Keypad settings" Width="900" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/flowboost;component/Views/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Make MX Keypad work the way you like." Foreground="{DynamicResource MutedForeground}" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,10">
            <StackPanel>
                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountStatus" Text="Checking sign-in…" Foreground="{DynamicResource MutedForeground}" Margin="0,5,0,14" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Sign in to GitHub Copilot with a one-time code. The code and approval link will appear in a secure sign-in window." Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,13" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}" Click="SignIn_Click" />
                            <Button x:Name="SignOutButton" Content="Sign out" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="SignOut_Click" />
                        </StackPanel>
                        <TextBlock Text="Signing in again replaces the saved sign-in only after you approve it. Cancel to keep your current saved sign-in." Foreground="{DynamicResource MutedForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="Signing out removes flowboost's GitHub Copilot sign-in; it does not sign you out of other apps." Foreground="{DynamicResource MutedForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock x:Name="AccountFeedback" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,9,0,0" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Model" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Choose which Copilot model writes your answers." Foreground="{DynamicResource MutedForeground}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="True" MinHeight="35" />
                            <Button x:Name="RefreshModelsButton" Grid.Column="1" Content="Refresh models" Style="{StaticResource QuietButton}" Margin="9,0,0,0" Click="RefreshModels_Click" />
                        </Grid>
                        <TextBlock x:Name="ModelStatus" Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Prompts" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Set the prompt and key for each action." Foreground="{DynamicResource MutedForeground}" Margin="0,4,0,12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="RemovePreset_Click" />
                            <Button Grid.Column="2" Content="+ Add prompt" Style="{StaticResource PrimaryButton}" Click="AddPreset_Click" />
                        </Grid>
                        <Grid Grid.Row="1" MinHeight="260">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ListBox x:Name="PresetList" SelectionChanged="PresetList_SelectionChanged" Background="{DynamicResource PanelAltBackground}" BorderThickness="0" Padding="4" />
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
                                    <TextBox x:Name="PresetNameBox" Grid.Column="1" TextChanged="PresetField_Changed" />
                                    <CheckBox x:Name="PresetEnabledCheck" Grid.Column="2" Content="Enabled" Margin="12,0,0,0" Checked="PresetEnabled_Changed" Unchecked="PresetEnabled_Changed" />
                                </Grid>
                                <TextBlock Text="Prompt" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,5" />
                                <TextBox x:Name="PromptBox" MinHeight="100" MaxHeight="165" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="PresetField_Changed" />
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Language" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
                                    <TextBox x:Name="LanguageBox" Grid.Column="1" TextChanged="PresetField_Changed" />
                                    <TextBlock Grid.Column="2" Text="Hotkey" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBox x:Name="HotkeyBox" Grid.Column="3" IsReadOnly="True" ToolTip="Click, then press a key combination" PreviewMouseLeftButtonDown="HotkeyBox_Click" PreviewKeyDown="HotkeyBox_KeyDown" />
                                </Grid>
                                <TextBlock x:Name="HotkeyHint" Text="Click the hotkey box, then press a key combination." FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="85,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start MX Keypad when I sign in" Margin="0,0,0,15" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Appearance" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/flowboost;component/public/flowboost-transparent.png" Width="72" Height="72" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="flowboost app icon" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="flowboost" Margin="0,7,0,0" />
                            <TextBlock x:Name="AppVersionText" Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,3,0,0" AutomationProperties.Name="Application version" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="What changed" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Margin="14,0,0,0" Click="WhatChanged_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,13,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel" Style="{StaticResource QuietButton}" Margin="0,0,9,0" Click="Cancel_Click" />
                    <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
