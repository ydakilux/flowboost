<Window x:Class="flowboost.Views.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating flowboost" Width="420" Height="230" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Icon="/flowboost;component/public/flowboost-transparent.png">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/flowboost;component/Views/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Downloading the update" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="flowboost will verify the download before it restarts." Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,6,0,18" />
            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" Text="Preparing download…" Foreground="{DynamicResource MutedForeground}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OpenGitHubButton" Content="Open GitHub" Style="{StaticResource QuietButton}" Visibility="Collapsed" Click="OpenGitHub_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
