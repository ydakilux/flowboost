<Window x:Class="flowboost.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What changed" Width="620" Height="560" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/flowboost;component/Views/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="What changed" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedForeground}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ReleaseNotesText" IsReadOnly="True" IsTabStop="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="ReleaseNotesError" Grid.Row="1" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="14" VerticalAlignment="Top" AutomationProperties.LiveSetting="Assertive" />
        <Button Grid.Row="2" Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
