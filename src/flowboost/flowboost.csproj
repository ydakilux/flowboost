<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>flowboost</Product>
    <ApplicationIcon>public\flowboost.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PdbFile> </PdbFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.14" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="flowboost.CHANGELOG.md" />
    <EmbeddedResource Include="public/flowboost.ico" LogicalName="flowboost.public.flowboost.ico" />
    <Resource Include="public/flowboost-transparent.png" />
  </ItemGroup>
  <PropertyGroup><NoWarn>$(NoWarn);GHCP001</NoWarn></PropertyGroup>
</Project>
